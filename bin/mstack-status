#!/usr/bin/env python3
"""mstack-status — deterministic inventory of an MStack paper folder.

Backs /mstack:paper-status. One call replaces a couple of dozen globs, greps,
and stat lookups: it prints the paper's main idea (.mstack/spine.md), the
config summary, every pipeline artifact with its state (present / thin / stub
/ missing), date, and verdict line, the verdicts that are stale because an
input changed after they were written, the stage the artifacts imply, whether
that agrees with paper.status in .mstack/config.yaml, and the argument chain:
the links a reader has to accept for the claim to land, each rated from its
verdict, with the weakest one named. It never writes anything. Standard
library only.

Usage:
  mstack-status                 # inspect the paper folder at or above cwd
  mstack-status path/to/paper
  mstack-status --json          # machine-readable
"""
from __future__ import annotations

import datetime as dt
import glob
import json
import os
import re
import sys
from pathlib import Path

STAGES = ["ideate", "map", "design", "build", "analyze", "write", "submit", "reflect"]
STATUS_STAGE = {
    "ideating": "ideate", "mapping": "map", "designing": "design",
    "building": "build", "analyzing": "analyze", "writing": "write",
    "submitted": "submit", "r-and-r": "submit", "accepted": "submit",
    "archived": "reflect",
}

# (stage, pattern, kind, required, skill that produces it). kind: "verdict"
# pulls the first Verdict/Recommendation line; "sections" reports
# drafted-vs-stub counts; "files" counts non-stub files; "spine" reads the
# five lines of .mstack/spine.md. Patterns may list alternatives with "|".
# Only required artifacts count as gaps; optional ones are shown but never
# set the next step. survey-design becomes required when design.type mentions
# a survey.
SPINE = ".mstack/spine.md"
ARTIFACTS = [
    ("ideate", SPINE, "spine", True, "/mstack:research-question"),
    ("ideate", ".mstack/research-question.md", "verdict", True, "/mstack:research-question"),
    ("ideate", ".mstack/idea-shotgun-*.md", "file", False, "/mstack:idea-shotgun"),
    ("ideate", ".mstack/scope-challenge-*.md", "verdict", False, "/mstack:scope-challenge"),
    ("map", "lit/pdf/*.pdf", "files", False, ""),
    ("map", "lit/index.md", "file", False, "/mstack:pdf-ingest"),
    ("map", ".mstack/lit-map.md", "file", True, "/mstack:lit-map"),
    ("map", ".mstack/theory.md", "file", True, "/mstack:theory-build"),
    ("map", ".mstack/claim-sharpen-*.md", "file", False, "/mstack:claim-sharpen"),
    ("map", ".mstack/hypotheses.md", "file", True, "/mstack:hypothesis-design"),
    ("map", ".mstack/identification-review-*.md", "verdict", True, "/mstack:identification-review"),
    ("design", ".mstack/design-research.md", "file", True, "/mstack:design-research"),
    ("design", ".mstack/power-analysis.md", "verdict", True, "/mstack:power-analysis"),
    ("design", ".mstack/survey-design.md", "file", False, "/mstack:survey-build"),
    ("design", "prereg/osf-prereg.md", "file", False, "/mstack:preregister"),
    ("build", "data/raw/PROVENANCE.md", "file", True, "/mstack:data-acquire"),
    ("build", "data/clean/analytic.rds", "file", True, "/mstack:data-clean"),
    ("build", "data/codebook.md", "file", True, "/mstack:codebook"),
    ("analyze", "code/02-analyze.R", "file", True, "/mstack:analyze"),
    ("analyze", "output/tables/*.tex", "files", True, "/mstack:analyze"),
    ("analyze", ".mstack/results-audit-*.md", "verdict", True, "/mstack:results-audit"),
    ("analyze", ".mstack/robustness-*.md", "verdict", True, "/mstack:robustness"),
    ("analyze", "output/figures/*.pdf|output/figures/*.png", "files", True, "/mstack:viz"),
    ("write", ".mstack/outline.md", "file", True, "/mstack:argument-outline"),
    ("write", "paper/sections/*.tex|paper/sections/*.qmd", "sections", True, "/mstack:draft-section"),
    ("write", ".mstack/referee-cache/*.md", "verdict", True, "/mstack:coauthor-review"),
    ("write", ".mstack/title-shotgun-*.md", "file", False, "/mstack:title-shotgun"),
    ("submit", ".mstack/journal-fit-*.md", "file", True, "/mstack:journal-fit"),
    ("submit", "submission/submission-checklist-*.md", "file", True, "/mstack:submission-pack"),
    ("submit", "submission/cover-letter.md", "file", True, "/mstack:cover-letter"),
    ("submit", "submission/response-to-reviewers/*-response.md", "file", False, "/mstack:r-and-r"),
    ("reflect", ".mstack/retro.md", "file", True, "/mstack:retro"),
    ("reflect", "replication-manifest.txt", "file", True, "/mstack:archive"),
]

# A verdict is stale when any of these inputs is newer than the newest
# matching verdict file.
STALE_INPUTS = {
    ".mstack/results-audit-*.md": ["code/01-clean.R", "code/02-analyze.R", "code/04-tables.R", "data/clean/analytic.rds"],
    ".mstack/robustness-*.md": ["code/02-analyze.R", "code/05-robustness.R", "data/clean/analytic.rds"],
    ".mstack/identification-review-*.md": [".mstack/research-question.md", ".mstack/lit-map.md", ".mstack/theory.md",
                                           ".mstack/hypotheses.md", "paper/sections/methods.*", "code/02-analyze.R"],
    ".mstack/referee-cache/*.md": ["paper/sections/*"],
    ".mstack/lit-map.md": ["lit/index.md"],
    ".mstack/theory.md": [".mstack/lit-map.md"],
    ".mstack/hypotheses.md": [".mstack/theory.md"],
    ".mstack/design-research.md": [".mstack/identification-review-*.md", ".mstack/hypotheses.md"],
    ".mstack/power-analysis.md": [".mstack/design-research.md", ".mstack/hypotheses.md"],
    "prereg/osf-prereg.md": [".mstack/hypotheses.md", ".mstack/power-analysis.md", ".mstack/survey-design.md"],
    "data/codebook.md": ["data/clean/analytic.rds", "code/01-clean.R"],
    ".mstack/journal-fit-*.md": ["paper/sections/abstract.*"],
    ".mstack/title-shotgun-*.md": ["paper/sections/abstract.*"],
    "submission/cover-letter.md": [".mstack/journal-fit-*.md", "paper/sections/abstract.*", SPINE],
    # The claim predates what was found; the outline predates the claim.
    SPINE: [".mstack/results-audit-*.md", ".mstack/robustness-*.md"],
    ".mstack/outline.md": [SPINE],
}

SPINE_FIELDS = ("Claim", "Who must change their mind", "Carried by", "Strongest rival", "Does not cover")

# How a verdict line rates the link it speaks to. The earliest keyword in the
# line wins, so "Conditional pass" is weak and "Pass" holds.
VERDICT_WORDS = [
    ("broken", r"\b(fail|red|fragile|mismatch|multi-paper|reject)\b"),
    ("weak", r"\b(conditional|yellow|sensitive|sprawl|partial|major revisions?)\b"),
    ("holds", r"\b(pass|green|stable|tight|match|accept|minor revisions?)\b"),
]

STUB_MARKER = "writes here"
THIN_CHARS = 250          # non-comment chars below which a real artifact is suspicious
SECTION_CHARS = 1000      # a drafted manuscript section is longer than this


def find_project(start: Path):
    p = start.resolve()
    for c in [p, *p.parents]:
        if (c / ".mstack").is_dir():
            return c
    return None


def read_config(project: Path) -> dict:
    """Minimal reader for the few config.yaml keys status needs (no PyYAML)."""
    cfg = {"title": "", "short_name": "", "format": "", "status": "", "prereg": "",
           "prereg_url": "", "type": "", "journals": [], "writing_style": ""}
    try:
        lines = (project / ".mstack" / "config.yaml").read_text().splitlines()
    except OSError:
        return cfg
    section = None
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        line = raw.split(" #")[0].strip()
        if indent == 0:
            section = line.rstrip(":") if line.endswith(":") else None
            continue
        key, _, value = line.partition(":")
        key, value = key.strip().lstrip("- ").strip(), value.strip().strip("\"'")
        if section == "paper" and key in cfg:
            cfg[key] = value
        elif section == "design" and key in ("prereg", "prereg_url", "type"):
            cfg[key] = value
        elif section == "voice" and key == "writing_style":
            cfg[key] = value
        elif section == "target_journals" and key == "name" and value:
            cfg["journals"].append(value)
    return cfg


def _repetitive(lines) -> bool:
    """Placeholder text is often one line or sentence pasted several times."""
    sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", " ".join(lines)) if s.strip()]
    for units in (lines, sentences):
        if len(units) >= 4 and len(set(units)) / len(units) <= 0.5:
            return True
    return False


def content_state(path: Path, min_chars: int = THIN_CHARS) -> str:
    """'stub' (template placeholder or empty), 'thin' (too small or too
    repetitive to be a real artifact of its kind; open it before trusting it),
    or 'present'."""
    try:
        text = path.read_text(errors="ignore")
    except OSError:
        return "stub"
    if STUB_MARKER in text:
        return "stub"
    suffix = path.suffix.lower()
    if suffix in (".tex", ".qmd", ".md", ".r", ".txt"):
        body = []
        for line in text.splitlines():
            s = line.strip()
            if not s or s.startswith(("%", "<!--", "#")) and suffix != ".md":
                continue
            if suffix == ".r" and (s.startswith("#") or s.startswith("library(")):
                continue
            body.append(s)
        n = len(" ".join(body))
        if n < 40:
            return "stub"
        return "thin" if n < min_chars or _repetitive(body) else "present"
    size = path.stat().st_size
    return "stub" if size == 0 else "thin" if size < min_chars else "present"


def is_stub(path: Path) -> bool:
    return content_state(path) != "present"


def verdict_line(path: Path) -> str:
    """First Verdict/Recommendation line; if that line is only a heading, the line after it."""
    def clean(s):
        return re.sub(r"\s+", " ", re.sub(r"[*#_`>\-\[\]]+", " ", s)).strip()
    try:
        lines = [l for l in path.read_text(errors="ignore").splitlines() if l.strip()]
    except OSError:
        return ""
    for i, line in enumerate(lines):
        if re.search(r"\b(verdict|recommendation)\b", line, re.I):
            text = clean(line)
            if re.fullmatch(r"(?i)(the )?(verdict|recommendation):?", text) and i + 1 < len(lines):
                text = f"{text.rstrip(':')}: {clean(lines[i + 1])}"
            return text[:90]
    return ""


def read_spine(project: Path) -> dict:
    """The five lines of .mstack/spine.md and the last entry of its log.
    state: 'missing', 'stub' (no claim), 'thin' (a claim and fewer than two
    of the other four lines), or 'present'."""
    path = project / SPINE
    out = {"state": "missing", "fields": {}, "filled": 0, "last_change": "", "date": ""}
    try:
        text = path.read_text(errors="ignore")
    except OSError:
        return out
    out["date"] = day(mtime(path))
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    head, _, log = text.partition("\n## Log")
    for name in SPINE_FIELDS:
        m = re.search(r"^\s*\*\*" + re.escape(name) + r":?\*\*:?[ \t]*(.*)$", head, re.M | re.I)
        if m and m.group(1).strip():
            out["fields"][name] = m.group(1).strip()
    out["filled"] = len(out["fields"])
    entries = [l.strip().lstrip("- ").strip() for l in log.splitlines() if l.strip().startswith("-")]
    out["last_change"] = entries[-1] if entries else ""
    out["state"] = "stub" if "Claim" not in out["fields"] else "thin" if out["filled"] < 3 else "present"
    return out


def rate(text: str) -> str:
    """'holds', 'weak', 'broken', or 'unrated' from a verdict line."""
    text = text.partition(":")[2] or text
    best = None
    for state, pattern in VERDICT_WORDS:
        m = re.search(pattern, text, re.I)
        if m and (best is None or m.start() < best[0]):
            best = (m.start(), state)
    return best[1] if best else "unrated"


def comprehension(path: Path) -> str:
    """The comprehension-test result a review records in its header:
    'match', 'partial', 'mismatch', or '' when the review has none."""
    try:
        m = re.search(r"(?im)^[\W_]*comprehension[\W_]*:[\W_]*(match|partial|mismatch)\b",
                      path.read_text(errors="ignore"))
    except OSError:
        return ""
    return m.group(1).lower() if m else ""


def mtime(path: Path) -> float:
    try:
        return path.stat().st_mtime
    except OSError:
        return 0.0


def day(ts: float) -> str:
    return dt.date.fromtimestamp(ts).isoformat() if ts else ""


def matches(project: Path, pattern: str):
    hits = [Path(p) for alt in pattern.split("|") for p in glob.glob(str(project / alt))]
    return sorted((h for h in hits if h.is_file() and h.name != ".gitkeep"), key=mtime)


def inventory(project: Path, cfg: dict, spine: dict):
    rows, present_by_stage = [], {s: False for s in STAGES}
    for stage, pattern, kind, required, skill in ARTIFACTS:
        if pattern == ".mstack/survey-design.md" and "survey" in cfg.get("type", "").lower():
            required = True
        files = matches(project, pattern)
        row = {"stage": stage, "artifact": pattern, "required": required, "skill": skill,
               "state": "missing" if required else "optional", "date": "", "note": ""}
        if kind == "spine":
            row["state"], row["date"] = spine["state"], spine["date"]
            if spine["state"] in ("present", "thin"):
                present_by_stage[stage] = True
                claim = spine["fields"]["Claim"]
                row["note"] = f"{spine['filled']}/5 lines · {claim[:70]}{'…' if len(claim) > 70 else ''}"
            elif spine["state"] == "stub":
                row["note"] = "no claim written yet"
        elif files:
            newest = files[-1]
            row["date"] = day(mtime(newest))
            if kind == "sections":
                drafted = [f.stem for f in files if content_state(f, SECTION_CHARS) == "present"]
                stubs = [f.stem for f in files if content_state(f, SECTION_CHARS) != "present"]
                row["state"] = f"{len(drafted)}/{len(files)}"
                row["note"] = (f"drafted: {', '.join(drafted) or 'none'}"
                               + (f"; stub or thin: {', '.join(stubs)}" if stubs else ""))
                if drafted:
                    present_by_stage[stage] = True
                else:
                    row["state"] = "stub"
            elif kind == "files":
                real = [f for f in files if not is_stub(f)]
                row["state"] = f"{len(real)} file{'s' if len(real) != 1 else ''}" if real else "stub"
                if real:
                    present_by_stage[stage] = True
            else:
                state = content_state(newest)
                row["state"] = state
                if state == "present":
                    present_by_stage[stage] = True
                    if kind == "verdict":
                        row["note"] = verdict_line(newest)
                elif state == "thin":
                    row["note"] = "too small or repetitive to be a real artifact; open it before trusting it"
                if len(files) > 1:
                    row["note"] = (row["note"] + f" ({len(files)} files; newest shown)").strip()
        rows.append(row)
    return rows, present_by_stage


def stale_verdicts(project: Path, spine: dict):
    out = []
    for pattern, inputs in STALE_INPUTS.items():
        if pattern == SPINE and spine["state"] in ("missing", "stub"):
            continue    # no claim to be out of date
        files = [f for f in matches(project, pattern) if content_state(f) != "stub"]
        if not files:
            continue
        newest = files[-1]
        for inp in inputs:
            if inp == SPINE and spine["state"] in ("missing", "stub"):
                continue
            for f in matches(project, inp):
                if content_state(f) != "stub" and mtime(f) > mtime(newest) + 1:
                    out.append({"pattern": pattern,
                                "verdict": str(newest.relative_to(project)), "verdict_date": day(mtime(newest)),
                                "input": str(f.relative_to(project)), "input_date": day(mtime(f))})
    return out


def derived_stage(present_by_stage):
    stage = None
    for s in STAGES:
        if present_by_stage[s]:
            stage = s
    return stage or "ideate"


GAP_STATES = ("missing", "stub", "thin")


def gap_rows(rows, stage, inclusive=True):
    """Required artifacts still missing in stages up to `stage`."""
    upto = STAGES[: STAGES.index(stage) + (1 if inclusive else 0)]
    return [r for r in rows if r["required"] and r["stage"] in upto and r["state"] in GAP_STATES]


def gaps_before(rows, stage):
    """Missing artifacts in stages up to and including the derived stage."""
    return [f"{r['stage']}: {r['artifact']} → {r['skill']}" for r in gap_rows(rows, stage)]


def argument(project: Path, rows, stale, spine: dict):
    """The chain of links a reader has to accept for the claim to land, each
    rated from the verdict that speaks to it: 'holds', 'weak' (holds with a
    stated condition), 'broken', 'stale' (an input changed after the verdict),
    'open' (not yet established), or 'unrated' (a verdict this script cannot
    read; open the file). Each link names the skill that would repair it."""
    by = {r["artifact"]: r for r in rows}
    stale_by = {}
    for s in stale:
        stale_by.setdefault(s.get("pattern", ""), s)

    def ok(pattern):
        return by[pattern]["state"] not in GAP_STATES + ("optional",)

    def stale_note(pattern):
        s = stale_by[pattern]
        return f"{s['verdict']} ({s['verdict_date']}) predates {s['input']} ({s['input_date']})"

    def verdict_link(name, question, stage, pattern, skill, broken_skill=None):
        row = by[pattern]
        if not ok(pattern):
            return {"link": name, "question": question, "stage": stage, "state": "open",
                    "evidence": f"no {pattern}", "skill": skill}
        if pattern in stale_by:
            return {"link": name, "question": question, "stage": stage, "state": "stale",
                    "evidence": stale_note(pattern), "skill": skill}
        state = rate(row["note"])
        return {"link": name, "question": question, "stage": stage, "state": state,
                "evidence": row["note"] or f"{pattern}: no verdict line found",
                "skill": broken_skill if state == "broken" and broken_skill else skill}

    links = []

    # 1. stated
    rq = by[".mstack/research-question.md"]
    link = {"link": "stated", "question": "Is there a claim?", "stage": "ideate"}
    if spine["state"] in ("missing", "stub"):
        link.update(state="open", evidence=f"no claim in {SPINE}",
                    skill="/mstack:claim-sharpen" if ok(".mstack/research-question.md") else "/mstack:research-question")
    else:
        rq_state = rate(rq["note"]) if ok(".mstack/research-question.md") else "holds"
        link.update(state=rq_state if rq_state in ("weak", "broken") else "holds",
                    evidence=f"spine {spine['filled']}/5 lines" + (f" · research-question: {rq['note']}" if rq["note"] else ""),
                    skill="/mstack:research-question")
    links.append(link)

    # 2. new
    lit = ".mstack/lit-map.md"
    link = {"link": "new", "question": "Is it new?", "stage": "map", "skill": "/mstack:lit-map"}
    unconverted = next((s for s in stale if s.get("kind") == "unconverted-pdfs"), None)
    if not ok(lit):
        link.update(state="open", evidence=f"no {lit}")
    elif lit in stale_by:
        link.update(state="stale", evidence=stale_note(lit))
    elif unconverted:
        link.update(state="stale", evidence=unconverted["note"], skill="/mstack:pdf-ingest")
    else:
        link.update(state="holds", evidence=f"{lit} ({by[lit]['date']})")
    links.append(link)

    # 3. derived
    theory, hyp = ".mstack/theory.md", ".mstack/hypotheses.md"
    link = {"link": "derived", "question": "Does it follow from a mechanism?", "stage": "map"}
    if not ok(theory):
        link.update(state="open", evidence=f"no {theory}", skill="/mstack:theory-build")
    elif theory in stale_by:
        link.update(state="stale", evidence=stale_note(theory), skill="/mstack:theory-build")
    elif not ok(hyp):
        link.update(state="open", evidence=f"no {hyp}", skill="/mstack:hypothesis-design")
    elif hyp in stale_by:
        link.update(state="stale", evidence=stale_note(hyp), skill="/mstack:hypothesis-design")
    else:
        link.update(state="holds", evidence=f"{theory} ({by[theory]['date']}), {hyp} ({by[hyp]['date']})",
                    skill="/mstack:theory-build")
    links.append(link)

    # 4. identified
    links.append(verdict_link("identified", "Can the design show it?", "map",
                              ".mstack/identification-review-*.md", "/mstack:identification-review",
                              broken_skill="/mstack:design-research"))

    # 5. estimated
    audit = ".mstack/results-audit-*.md"
    if not (ok("code/02-analyze.R") and ok("output/tables/*.tex")):
        links.append({"link": "estimated", "question": "Do the audited results show it?", "stage": "analyze",
                      "state": "open", "evidence": "no primary table yet", "skill": "/mstack:analyze"})
    else:
        links.append(verdict_link("estimated", "Do the audited results show it?", "analyze",
                                  audit, "/mstack:results-audit", broken_skill="/mstack:analyze"))

    # 6. robust
    links.append(verdict_link("robust", "Does it survive stress?", "analyze",
                              ".mstack/robustness-*.md", "/mstack:robustness",
                              broken_skill="/mstack:claim-sharpen"))

    # 7. current
    link = {"link": "current", "question": "Does the spine say what was found?", "stage": "analyze",
            "skill": "/mstack:claim-sharpen"}
    if spine["state"] in ("missing", "stub") or not ok(audit):
        link.update(state="open", evidence="no audited results to restate the claim against")
    elif SPINE in stale_by:
        link.update(state="stale", evidence=stale_note(SPINE))
    else:
        link.update(state="holds", evidence=f"spine edited {spine['date']}, after the audited results")
    links.append(link)

    # 8. organized
    outline = ".mstack/outline.md"
    link = {"link": "organized", "question": "Does every part of the paper serve it?", "stage": "write",
            "skill": "/mstack:argument-outline"}
    if not ok(outline):
        link.update(state="open", evidence=f"no {outline}")
    elif outline in stale_by:
        link.update(state="stale", evidence=stale_note(outline))
    else:
        link.update(state="holds", evidence=f"{outline} ({by[outline]['date']})")
    links.append(link)

    # 9. received
    cache = ".mstack/referee-cache/*.md"
    sections = by["paper/sections/*.tex|paper/sections/*.qmd"]["state"]
    drafted = re.fullmatch(r"(\d+)/(\d+)", sections)
    complete = bool(drafted) and drafted.group(1) == drafted.group(2)
    link = {"link": "received", "question": "Does a cold reader come away with it?", "stage": "write",
            "skill": "/mstack:coauthor-review" if complete else "/mstack:draft-section"}
    reviews = [f for f in matches(project, cache) if content_state(f) != "stub"]
    result = comprehension(reviews[-1]) if reviews else ""
    if not reviews:
        link.update(state="open", evidence="no review of a draft yet" if complete else f"draft incomplete (sections {sections})")
    elif cache in stale_by:
        link.update(state="stale", evidence=stale_note(cache))
    elif not result:
        link.update(state="open", evidence=f"{reviews[-1].name} records no comprehension test")
    else:
        link.update(state={"match": "holds", "partial": "weak", "mismatch": "broken"}[result],
                    evidence=f"comprehension {result} in {reviews[-1].name}")
        if result == "mismatch":
            link["skill"] = "/mstack:argument-outline"
    links.append(link)

    # An open link is reached through the pipeline: if a required artifact of
    # an earlier stage is missing, that is the step, not the link's own skill.
    for link in links:
        if link["state"] == "open":
            earlier = gap_rows(rows, link["stage"], inclusive=False)
            earlier = [r for r in earlier if r["artifact"] not in (SPINE, ".mstack/research-question.md")]
            if earlier and link["link"] != "stated":
                link["via"] = earlier[0]["artifact"]
                link["skill"] = earlier[0]["skill"] or link["skill"]
    return links


def weakest_link(links):
    """A broken link first; then the earliest link that is stale or not yet
    established; then, once every link has been tested, the earliest weak one."""
    for states in (("broken",), ("stale", "open"), ("weak",)):
        for link in links:
            if link["state"] in states:
                return link
    return None


def main(argv=None):
    args = [a for a in (argv or sys.argv[1:])]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    start = Path(args[0]) if args else Path.cwd()
    project = find_project(start)
    if project is None:
        print(f"No .mstack/ found at or above {start.resolve()}; run /mstack:mstack-init first.", file=sys.stderr)
        return 1
    cfg = read_config(project)
    spine = read_spine(project)
    rows, present = inventory(project, cfg, spine)
    stale = stale_verdicts(project, spine)  # stale artifacts, verdict files and upstream memos alike
    pdfs = [f for f in matches(project, "lit/pdf/*.pdf") if content_state(f) == "present"]
    index = matches(project, "lit/index.md")
    if pdfs and (not index or mtime(pdfs[-1]) > mtime(index[-1]) + 1):
        stale.append({"verdict": "lit/index.md", "verdict_date": day(mtime(index[-1])) if index else "missing",
                      "input": f"lit/pdf/ ({len(pdfs)} PDF{'s' if len(pdfs) != 1 else ''})", "input_date": day(mtime(pdfs[-1])),
                      "note": f"{len(pdfs)} PDF{'s' if len(pdfs) != 1 else ''} in lit/pdf/ newer than the index"
                              f"{'' if index else ' (no index yet)'}: not ingested, run /mstack:pdf-ingest",
                      "kind": "unconverted-pdfs"})
    stage = derived_stage(present)
    cfg_stage = STATUS_STAGE.get(cfg["status"], "")
    gaps = gaps_before(rows, stage)
    links = argument(project, rows, stale, spine)
    weakest = weakest_link(links)
    # With no gap behind it, the pipeline's next required artifact.
    ahead = [r for r in rows if r["required"] and r["state"] in GAP_STATES
             and STAGES.index(r["stage"]) > STAGES.index(stage)]
    next_artifact = ahead[0] if ahead and not gaps else None
    result = {
        "project": str(project), "config": cfg, "spine": spine, "artifacts": rows, "stale": stale,
        "derived_stage": stage, "config_stage": cfg_stage,
        "status_matches": (cfg_stage == stage) if cfg_stage else None, "gaps": gaps,
        "argument": links, "weakest_link": weakest, "next_artifact": next_artifact,
    }
    if as_json:
        print(json.dumps(result, indent=2))
        return 0

    name = cfg["title"] or cfg["short_name"] or project.name
    print(f"MStack status: {name}")
    print(f"  folder {project}")
    print(f"  config: status={cfg['status'] or '?'} (stage {cfg_stage or '?'}) · format={cfg['format'] or '?'} "
          f"· design={cfg['type'] or '?'} · prereg={cfg['prereg'] or 'false'} · writing_style={cfg['writing_style'] or '(none)'}")
    print(f"  journals: {', '.join(cfg['journals']) or '(none set)'}")
    print()
    if spine["state"] in ("missing", "stub"):
        print(f"SPINE: no claim in {SPINE} — nothing below can be ranked by its bearing on the main idea.")
    else:
        print(f"SPINE ({SPINE}, {spine['filled']}/5 lines, edited {spine['date']}):")
        for field in SPINE_FIELDS:
            print(f"  {field}: {spine['fields'].get(field, '(not yet written)')}")
        if spine["last_change"]:
            print(f"  Last change: {spine['last_change']}")
    print()
    print(f"{'STAGE':8} {'ARTIFACT':46} {'STATE':9} {'DATE':11} NOTE   (optional = not required; thin = present but suspiciously small)")
    for r in rows:
        print(f"{r['stage']:8} {r['artifact']:46} {r['state']:9} {r['date']:11} {r['note']}")
    print()
    if stale:
        print("STALE (an input changed after this file was written):")
        for s in stale:
            if s.get("kind") == "unconverted-pdfs":
                print(f"  - {s['note']} (newest PDF {s['input_date']})")
            else:
                print(f"  - {s['verdict']} ({s['verdict_date']}) predates {s['input']} ({s['input_date']})")
    else:
        print("STALE: none")
    print()
    agree = "matches config" if cfg_stage == stage else f"config says {cfg['status'] or '?'} (stage {cfg_stage or '?'}) — MISMATCH"
    print(f"DERIVED STAGE: {stage} — {agree}")
    print()
    print("ARGUMENT (the links a reader must accept; broken, then stale or open, then weak):")
    for l in links:
        print(f"  {l['link']:11} {l['state']:8} {l['question']:40} {l['evidence']}")
    print()
    if weakest is None:
        print("WEAKEST LINK: none — every link holds. The next step is the earliest gap below, "
              "or the next artifact in the pipeline.")
    else:
        via = f" (first: {weakest['via']})" if weakest.get("via") else ""
        print(f"WEAKEST LINK: {weakest['link']} — {weakest['state']}: {weakest['evidence']} → {weakest['skill']}{via}")
        if weakest["state"] == "weak":
            print("  Only weak links remain. If this one has been answered as far as it can be, "
                  "the next step is the earliest gap below, or the next artifact in the pipeline.")
    if gaps:
        print()
        print("GAPS UP TO THAT STAGE (they set the next step only when they stand between the paper and its weakest link):")
        for g in gaps:
            print(f"  - {g}")
    elif next_artifact:
        print()
        print(f"NEXT IN THE PIPELINE: {next_artifact['stage']}: {next_artifact['artifact']} → {next_artifact['skill']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
