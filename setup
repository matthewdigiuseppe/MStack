#!/usr/bin/env bash
# MStack setup — puts the bin/ scripts on PATH and tells you how to register
# the skills.
#
# Skills come from Claude Code's plugin system, not from this script: MStack is
# a plugin (.claude-plugin/plugin.json plus skills/<name>/SKILL.md), and
# installing it that way is what namespaces the commands as /mstack:<name>.
# Earlier versions of this script symlinked the repository into
# ~/.claude/skills/mstack, which registered nothing, because Claude Code reads
# ~/.claude/skills/<name>/SKILL.md and MStack's skills sit a level deeper.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_SKILLS="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
LEGACY_LINK="$CLAUDE_SKILLS/mstack"

echo "MStack setup"
echo "  source: $HERE"

# Make bin scripts executable.
chmod +x "$HERE"/bin/* 2>/dev/null || true
chmod +x "$HERE"/setup

# Clean up the symlink older versions of this script created; it never worked.
if [[ -L "$LEGACY_LINK" ]]; then
  target="$(readlink "$LEGACY_LINK")"
  rm -f "$LEGACY_LINK"
  echo "  removed stale symlink $LEGACY_LINK -> $target (it did not register any skills)"
elif [[ -e "$LEGACY_LINK" ]]; then
  echo "  note: $LEGACY_LINK exists and is not a symlink; leaving it alone."
fi

echo ""
echo "1. Register the skills (in Claude Code, one line at a time):"
echo "     /plugin marketplace add matthewdigiuseppe/MStack"
echo "     /plugin install mstack@mstack"
echo ""
echo "   To install from this clone instead of GitHub, point the first command"
echo "   at this directory:"
echo "     /plugin marketplace add $HERE"
echo "     /plugin install mstack@mstack"
echo "   Then all 39 commands are available as /mstack:<name>; /plugin lists them."
echo ""

# Suggest PATH addition for the command-line tools.
case ":$PATH:" in
  *":$HERE/bin:"*)
    echo "2. Command-line tools: $HERE/bin is already on your PATH."
    ;;
  *)
    echo "2. Command-line tools (mstack-init, mstack-status, mstack-pdf2md) —"
    echo "   add bin/ to your PATH:"
    echo "     echo 'export PATH=\"$HERE/bin:\$PATH\"' >> ~/.zshrc"
    ;;
esac

echo ""
echo "Done."
